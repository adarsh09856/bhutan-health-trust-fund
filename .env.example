# Bhutan Health Trust Fund (BHTF) Environment Configuration

# PostgreSQL Connection String (e.g. Supabase, Neon, or local PostgreSQL instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bhtf_db"

# Session Security Secret
SESSION_SECRET="bhtf_secure_production_secret_key_2026"

# Default Admin Credentials for initial setup
ADMIN_EMAIL="admin@bhtf.bt"
ADMIN_PASSWORD="Admin@BHTF2026"

# Node Environment
NODE_ENV="development"
