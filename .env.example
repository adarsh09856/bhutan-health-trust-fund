# PostgreSQL aaPanel Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://newdb:newdb@127.0.0.1:5432/newdb"

# Session Security Key for Signed Secretariat Tokens
SESSION_SECRET="bhtf_secure_sovereign_secret_key_2026"

# Server Port
PORT=6060
